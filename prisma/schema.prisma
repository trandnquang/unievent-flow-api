generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model checkin_logs {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id      String         @unique @db.Uuid
  organizer_id   String?        @db.Uuid
  checkin_method checkin_method @default(qr_scan)
  checkin_time   DateTime       @default(now()) @db.Timestamptz(6)
  users          users?         @relation(fields: [organizer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tickets        tickets        @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([checkin_time], map: "idx_checkin_logs_checkin_time")
  @@index([organizer_id], map: "idx_checkin_logs_organizer_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model events {
  id                               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizer_id                     String              @db.Uuid
  title                            String              @db.VarChar(255)
  description                      String?
  cover_image                      String?             @db.VarChar(500)
  location                         String?             @db.VarChar(255)
  location_type                    event_location_type @default(in_person)
  join_url                         String?             @db.VarChar(500)
  category                         event_category?
  club_name                        String?             @db.VarChar(150)
  start_time                       DateTime            @db.Timestamptz(6)
  end_time                         DateTime            @db.Timestamptz(6)
  max_tickets                      Int
  status                           event_status        @default(active)
  cancel_reason                    String?
  cancelled_by                     String?             @db.Uuid
  cancelled_at                     DateTime?           @db.Timestamptz(6)
  created_at                       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime            @default(now()) @db.Timestamptz(6)
  event_co_hosts                   event_co_hosts[]
  event_schedule                   event_schedule[]
  event_updates                    event_updates[]
  users_events_cancelled_byTousers users?              @relation("events_cancelled_byTousers", fields: [cancelled_by], references: [id], onUpdate: NoAction)
  users                            users               @relation(fields: [organizer_id], references: [id], onUpdate: NoAction)
  feedbacks                        feedbacks[]
  registrations                    registrations[]

  @@index([organizer_id], map: "idx_events_organizer_id")
  @@index([status, category, club_name, start_time], map: "idx_events_search")
  @@index([status], map: "idx_events_status")
  @@index([cancelled_by], map: "idx_events_cancelled_by", where: raw("(cancelled_by IS NOT NULL)"))
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model feedbacks {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String           @db.Uuid
  user_id         String           @db.Uuid
  ticket_id       String           @unique @db.Uuid
  rating          Int              @db.SmallInt
  content         String?
  sentiment_label sentiment_label?
  keywords        String?
  analyzed_at     DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  events          events           @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tickets         tickets          @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id], map: "idx_feedbacks_event_id")
  @@index([sentiment_label], map: "idx_feedbacks_sentiment_label")
  @@index([event_id], map: "idx_feedbacks_unanalyzed", where: raw("((analyzed_at IS NULL) AND (content IS NOT NULL))"))
  @@index([user_id], map: "idx_feedbacks_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model registrations {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String              @db.Uuid
  user_id      String              @db.Uuid
  status       registration_status @default(pending)
  requested_at DateTime            @default(now()) @db.Timestamptz(6)
  processed_at DateTime?           @db.Timestamptz(6)
  events       events              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tickets      tickets?

  @@unique([event_id, user_id], map: "uq_registration_active_per_user_event", where: raw("(status = ANY (ARRAY['pending'::registration_status, 'confirmed'::registration_status]))"))
  @@index([event_id], map: "idx_registrations_event_id")
  @@index([status], map: "idx_registrations_status")
  @@index([user_id], map: "idx_registrations_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tickets {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registration_id String        @unique @db.Uuid
  jwt_code        String        @unique
  status          ticket_status @default(valid)
  issued_at       DateTime      @default(now()) @db.Timestamptz(6)
  checkin_logs    checkin_logs?
  feedbacks       feedbacks?
  registrations   registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_tickets_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                              String           @db.VarChar(150)
  email                             String           @unique @db.VarChar(255)
  password_hash                     String           @db.VarChar(255)
  role                              user_role
  avatar_url                        String?          @db.VarChar(500)
  club_name                         String?          @db.VarChar(150)
  bio                               String?          @db.VarChar(160)
  social_links                      Json?
  is_active                         Boolean          @default(true)
  reset_token                       String?          @db.VarChar(255)
  reset_token_expires               DateTime?        @db.Timestamptz(6)
  created_at                        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime         @default(now()) @db.Timestamptz(6)
  checkin_logs                      checkin_logs[]
  event_co_hosts                    event_co_hosts[]
  event_updates                     event_updates[]
  events_events_cancelled_byTousers events[]         @relation("events_cancelled_byTousers")
  events                            events[]
  feedbacks                         feedbacks[]
  registrations                     registrations[]

  @@index([reset_token], map: "idx_users_reset_token", where: raw("(reset_token IS NOT NULL)"))
  @@index([role], map: "idx_users_role")
  @@index([is_active], map: "idx_users_is_active")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model event_co_hosts {
  event_id     String         @db.Uuid
  user_id      String         @db.Uuid
  status       co_host_status @default(pending)
  added_at     DateTime       @default(now()) @db.Timestamptz(6)
  responded_at DateTime?      @db.Timestamptz(6)
  events       events         @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, user_id])
  @@index([user_id], map: "idx_event_co_hosts_user_id")
  @@index([user_id, status], map: "idx_event_co_hosts_user_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model event_schedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  start_time DateTime @db.Timestamptz(6)
  title      String   @db.VarChar(255)
  location   String?  @db.VarChar(255)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  events     events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id], map: "idx_event_schedule_event_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model event_updates {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String   @db.Uuid
  organizer_id String   @db.Uuid
  title        String   @db.VarChar(255)
  content      String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  events       events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [organizer_id], references: [id], onUpdate: NoAction)

  @@index([event_id, created_at(sort: Desc)], map: "idx_event_updates_event_id")
}

enum event_status {
  active
  cancelled
}

enum registration_status {
  pending
  confirmed
  failed
  cancelled
}

enum sentiment_label {
  positive
  negative
  neutral
}

enum ticket_status {
  valid
  checked_in
  cancelled
}

enum user_role {
  student
  organizer
  admin
}

enum checkin_method {
  qr_scan
  self
}

enum event_location_type {
  in_person
  online
}

enum co_host_status {
  pending
  accepted
  declined
}

enum event_category {
  academic
  competition
  seminar_workshop
  career
  volunteer
  arts_entertainment
  sports
  orientation
  other
}
