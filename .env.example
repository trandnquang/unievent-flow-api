# Cổng chạy ứng dụng API Server
PORT=3000

# Chuỗi kết nối PostgreSQL (Docker container unievent_postgres)
DATABASE_URL="postgresql://root:1234@localhost:5432/unievent_flow?schema=public"

# Khóa bí mật cho JWT (tối thiểu 10 ký tự)
JWT_SECRET="unievent-flow-super-secret-key-2026"

# Thời gian hết hạn của JWT Access Token, tính bằng GIÂY (7200 = 2 giờ, API.md mục 1.4).
# Dùng chung cho cả chữ ký JWT lẫn trường expires_in trả về client.
JWT_EXPIRES_IN=7200

# Khoá bí mật ký JWT của VÉ điện tử (BR-51/BR-99) — PHẢI khác JWT_SECRET ở trên.
# Vé sống tới end_time+24h và bị in ra mã QR phát tán công khai; tách secret để một secret
# bị lộ không kéo theo giả mạo phiên đăng nhập, và ngược lại.
TICKET_JWT_SECRET="unievent-flow-ticket-secret-key-2026"

# BR-88: thời gian giữ chỗ (giây) cho đăng ký đang chờ worker xử lý.
# Dùng cho cả TTL khoá hold:{registrationId} lẫn độ trễ job kiểm tra quá hạn.
REGISTRATION_HOLD_TTL_SECONDS=60

# Chuỗi kết nối Redis (rate-limit store, hàng đợi BullMQ, khoá nghiệp vụ)
REDIS_URL="redis://localhost:6379"

# --- SMTP cho worker gửi email (FR-07, FR-16, FR-35) ---
# Mặc định trỏ Mailpit/MailHog cục bộ: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST="localhost"
SMTP_PORT=1025
# Bỏ trống SMTP_USER/SMTP_PASS nếu máy chủ SMTP không yêu cầu xác thực
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UniEvent Flow <no-reply@unievent.local>"

# Gốc đường dẫn trang đặt lại mật khẩu phía Frontend (FR-07)
APP_RESET_URL="http://localhost:5173/reset-password"

# Gốc đường dẫn trang chi tiết sự kiện phía Frontend — dùng trong email thông báo sự kiện
# (FR-31) và email mời Co-host (BR-46b). Link đầy đủ: {APP_EVENT_URL}/{eventId}
APP_EVENT_URL="http://localhost:5173/events"

# Gốc đường dẫn trang vé phía Frontend (FR-18) — email xác nhận vé ghép thành
# {APP_TICKET_URL}/{ticketId}
APP_TICKET_URL="http://localhost:5173/tickets"

# Trang đăng nhập phía Frontend — email cấp tài khoản Ban tổ chức (FR-38) trỏ về đây
APP_LOGIN_URL="http://localhost:5173/login"

# BR-57: gửi email nhắc lịch trước giờ bắt đầu sự kiện bao nhiêu giờ
REMINDER_LEAD_TIME_HOURS=24

# BR-98 (CBR 7): TTL cache trạng thái tài khoản trên Redis (giây).
# requireActive đọc cache thay vì truy vấn CSDL mỗi request; FR-29 xoá cache ngay khi đổi.
ACTIVE_CACHE_TTL_SECONDS=60

# BR-91: TTL khoá nguyên tử chống check-in trùng (giây). 86400 = 24h, khớp biên hết hạn vé BR-99.
CHECKIN_LOCK_TTL_SECONDS=86400

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGIN="http://localhost:5173"

# --- FR-25/26: phân tích cảm xúc bằng Google Gemini ---
# Thiếu khoá thì API vẫn khởi động, chỉ riêng endpoint phân tích báo lỗi rõ ràng.
GEMINI_API_KEY=""
# Tránh bí danh trôi (`gemini-flash-latest`): Google đổi model phía sau thì kết quả phân tích
# tự đổi mà không có thay đổi nào bên mình. Họ `gemini-2.5-*` đã bị khoá với tài khoản mới (404).
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- FR-40 (BR-111): lưu trữ ảnh trên Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="unieventflow"
# BR-104: dung lượng ảnh tối đa (MB)
MAX_UPLOAD_SIZE_MB=5

# --- Assumption #11: tài khoản Quản trị viên đầu tiên ---
# Chỉ `npm run seed:admin` đọc 3 biến này. KHÔNG có endpoint public nào tạo được admin.
ADMIN_SEED_EMAIL="admin@unievent.local"
ADMIN_SEED_PASSWORD="Admin@12345"
ADMIN_SEED_NAME="Quản trị viên hệ thống"
