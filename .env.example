# Cổng chạy ứng dụng API Server
PORT=3000

# Chuỗi kết nối PostgreSQL (Docker container unievent_postgres)
DATABASE_URL="postgresql://root:1234@localhost:5432/unievent_flow?schema=public"

# Khóa bí mật cho JWT (tối thiểu 10 ký tự)
JWT_SECRET="unievent-flow-super-secret-key-2026"

# Thời gian hết hạn của JWT Access Token, tính bằng GIÂY (7200 = 2 giờ, API.md mục 1.4).
# Dùng chung cho cả chữ ký JWT lẫn trường expires_in trả về client.
JWT_EXPIRES_IN=7200

# Chuỗi kết nối Redis (rate-limit store, hàng đợi BullMQ, khoá nghiệp vụ)
REDIS_URL="redis://localhost:6379"

# --- SMTP cho worker gửi email (FR-07, FR-16, FR-35) ---
# Mặc định trỏ Mailpit/MailHog cục bộ: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST="localhost"
SMTP_PORT=1025
# Bỏ trống SMTP_USER/SMTP_PASS nếu máy chủ SMTP không yêu cầu xác thực
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UniEvent Flow <no-reply@unievent.local>"

# Gốc đường dẫn trang đặt lại mật khẩu phía Frontend (FR-07)
APP_RESET_URL="http://localhost:5173/reset-password"
