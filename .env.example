# Cổng chạy ứng dụng API Server
PORT=3000

# Chuỗi kết nối PostgreSQL (Docker container unievent_postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unievent?schema=public"

# Khóa bí mật cho JWT (tối thiểu 10 ký tự)
JWT_SECRET="unievent-flow-super-secret-key-2026"

# Thời gian hết hạn của JWT Access Token
JWT_EXPIRES_IN="2h"

# Chuỗi kết nối Redis (Dự phòng cho Tuần 3-6)
REDIS_URL="redis://localhost:6379"